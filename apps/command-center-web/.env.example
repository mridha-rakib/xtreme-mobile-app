# ==============================================================================
# XTREME Command Center Web — Environment Configuration Example
# ==============================================================================
# Note: Fictional frontend-only development setup.
# Never commit real API keys, database credentials, Stripe secret keys,
# production session secrets, or private tokens.
# ==============================================================================

# Application Environment: development | preview | production
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo & QA Controls:
# - Set to true in development / QA preview to enable mock persona switcher and demo flows.
# - In production builds, this MUST be false or omitted; all QA controls are completely disabled and fail closed.
NEXT_PUBLIC_ENABLE_DEMO_BYPASS=true

# Mock API Latency (ms) for simulating asynchronous queries (0 for instant)
NEXT_PUBLIC_MOCK_API_LATENCY=0
