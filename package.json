{
  "name": "xtreme-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "customer": "pnpm --filter @xtreme/customer-mobile start",
    "staff": "pnpm --filter @xtreme/staff-mobile start",
    "admin": "pnpm --filter @xtreme/command-center-web dev",
    "admin:build": "pnpm --filter @xtreme/command-center-web build",
    "admin:start": "pnpm --filter @xtreme/command-center-web start",
    "admin:typecheck": "pnpm --filter @xtreme/command-center-web typecheck",
    "test:admin": "pnpm --filter @xtreme/command-center-web test",
    "test:admin:e2e": "pnpm --filter @xtreme/command-center-web test:e2e",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:docs": "prettier --write \"**/*.md\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "prepare": "husky",
    "test:routes": "node scripts/validate-routes.mjs",
    "test:demo": "node scripts/test-demo-mode.mjs",
    "test:branding": "node scripts/test-branding-acceptance.mjs",
    "test:discovery": "node scripts/test-discovery-journey.mjs",
    "test:booking": "node scripts/test-booking-journey.mjs",
    "test:payments": "node scripts/test-batch3-payments-modifications.mjs",
    "test:concierge": "node scripts/test-concierge-module.mjs",
    "test:customer-account": "node scripts/test-customer-account.mjs",
    "test:customer-final": "node scripts/test-final-customer-acceptance.mjs",
    "test:staff-assignments": "node scripts/test-staff-assignments.mjs",
    "test": "node scripts/validate-routes.mjs && node scripts/test-demo-mode.mjs && node scripts/test-branding-acceptance.mjs && node scripts/test-discovery-journey.mjs && node scripts/test-booking-journey.mjs && node scripts/test-batch3-payments-modifications.mjs && node scripts/test-concierge-module.mjs && node scripts/test-customer-account.mjs && node scripts/test-final-customer-acceptance.mjs && node scripts/test-staff-assignments.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react-native-svg": "^15.16.1"
  }
}
